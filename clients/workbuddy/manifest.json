{
  "protocol": 1,
  "id": "workbuddy",
  "version": "0.2.0",
  "dependencies": {"shared": "0.1.0"},
  "label": "WorkBuddy official CLI resume / local assistant OpenAPI",
  "runtime": "python>=3.11",
  "entrypoint": "main.py",
  "session_kinds": ["cli-resumed-session", "official-local-assistant"],
  "native_transports": ["cli", "openapi"],
  "supported_modes": ["queue"],
  "native_validation": "unverified",
  "openapi_required_oauth_scopes": ["user.localassistant.invokable"],
  "completion": "native-execution-report",
  "cli_session_targeting": true,
  "desktop_inheritance_verified": false,
  "automatic_oauth_refresh": false
}
