{
  "protocol": 1,
  "id": "codex",
  "version": "0.1.0",
  "dependencies": {"shared": "0.1.0"},
  "label": "Codex native thread queue compatibility and result-only app-server proxy",
  "runtime": "python>=3.11",
  "entrypoint": "main.py",
  "session_kinds": ["desktop-thread"],
  "supported_modes": ["queue"],
  "native_validation": "external-proxy-guide-unverified-current-desktop-host-stdio-only",
  "completion": "native-execution-report",
  "transports": {
    "queue": {"default": true, "native_validation": "requires-native-host-and-tool-retention-verification"},
    "app-server": {"message_kinds": ["result"], "result_mode": "steer", "requires": "official-proxy-to-the-running-native-daemon", "idle_start": "explicit-native-verification-required", "queue_fallback": false}
  }
}
